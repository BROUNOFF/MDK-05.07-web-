# Скопируй этот файл и переименуй копию в .env (с точкой в начале).
# Пока строки пустые — приложение хранит данные в браузере (localStorage).

# Supabase: Project Settings -> API (Project URL и anon public / Publishable key)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# RAWG API (необязательно): ключ с https://rawg.io/apidocs
# Без ключа поиск работает по встроенному справочнику игр
VITE_RAWG_KEY=
