            "exec": [
              "pm.test('Код ответа 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Поиск игр в справочнике",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/games/search?q=portal",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "games",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "portal"
            }
          ]
        },
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код ответа 200', () => pm.response.to.have.status(200));",
              "pm.test('Найдена хотя бы одна игра', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Моя библиотека",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/library",
