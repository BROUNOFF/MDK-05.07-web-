{
  "info": {
    "name": "GameTrack API",
    "description": "REST API трекера бэклога игр. Сначала выполните «3. Вход» — токен подставится в остальные запросы.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userGameId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Проверка сервера",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Жив ли сервер и есть ли связь с PostgreSQL",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код ответа 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student{{$randomInt}}@vyatsu.ru\",\n  \"password\": \"secret123\",\n  \"name\": \"Новый пользователь\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код ответа 201', () => pm.response.to.have.status(201));",
              "pm.test('Есть токен', () => pm.expect(pm.response.json().token).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Вход (демо-аккаунт)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Токен из ответа автоматически сохраняется и подставляется во все следующие запросы",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@gametrack.ru\",\n  \"password\": \"demo123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код ответа 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);",
              "pm.test('Токен сохранён в переменную token', () => pm.expect(pm.collectionVariables.get('token')).to.not.be.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Вход с неверным паролем",
      "request": {
        "method": "POST",
