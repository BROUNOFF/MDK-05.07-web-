    {
      "name": "8. Добавить игру в библиотеку",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/library",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "library"
          ]
        },
        "description": "id созданной записи сохраняется в переменную userGameId",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"game\": {\n    \"id\": 1000000024,\n    \"title\": \"Portal 2\",\n    \"release_year\": 2011,\n    \"developer\": \"Valve\",\n    \"genres\": [\n      \"Puzzle\",\n      \"Adventure\"\n    ],\n    \"platforms\": [\n      \"PC\"\n    ],\n    \"cover_url\": \"https://cdn.cloudflare.steamstatic.com/steam/apps/620/library_600x900.jpg\"\n  },\n  \"status\": \"backlog\",\n  \"platform\": \"PC\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код ответа 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userGameId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Повторное добавление (ошибка 409)",
      "request": {
        "method": "POST",
