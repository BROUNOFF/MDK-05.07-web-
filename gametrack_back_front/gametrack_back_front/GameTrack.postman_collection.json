    {
      "name": "10. Изменить игру: статус, оценка, часы, цена",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/library/{{userGameId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "library",
            "{{userGameId}}"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"playing\",\n  \"rating\": 9,\n  \"playtime_hours\": 12,\n  \"price\": 249,\n  \"notes\": \"Отличные головоломки\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код ответа 200', () => pm.response.to.have.status(200));",
              "pm.test('Статус изменился', () => pm.expect(pm.response.json().status).to.eql('playing'));"
            ]
          }
        }
      ]
    },
