# Настройки сервера для запуска без Docker (в Docker они задаются в docker-compose.yml).
# Скопируй файл в .env и при необходимости поправь.

# Адрес базы: postgres://пользователь:пароль@хост:порт/имя_базы
DATABASE_URL=postgres://gametrack:gametrack@localhost:5432/gametrack

# Секрет для подписи токенов входа — любая длинная строка
JWT_SECRET=gametrack-local-secret

PORT=3000

# Необязательно: ключ RAWG API (https://rawg.io/apidocs) для поиска по большой базе игр
RAWG_KEY=
